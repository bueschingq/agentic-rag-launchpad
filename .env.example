# Copy to .env (never commit it). Used by the console, the worker and the M0 spike.

# --- Agentic RAG credentials -------------------------------------------------
# NUA key with KB management enabled (Manage account » NUA keys). Required: it creates KBs,
# service accounts and keys for every deployment. Zone and account are read from it.
PAR_NUA_KEY=

# Personal Access Token. Optional: adds account limits and processing/storage usage to the
# cost dashboard (the Account API rejects NUA keys). Sent as "Authorization: Bearer".
PAR_PAT=

# Optional overrides; normally resolved from the NUA key.
PAR_ACCOUNT=
PAR_ZONE=

# --- Console ----------------------------------------------------------------
DATABASE_URL=postgres://launchpad:launchpad@localhost:5432/launchpad

# 32 random bytes, base64. Encrypts every stored KB key. Generate with: openssl rand -base64 32
# Losing it means re-issuing every deployment's keys.
LAUNCHPAD_MASTER_KEY=

# Interim console sign-in (HTTP Basic, any username) until OIDC sign-in lands in M1.
# The console refuses admin requests while this is empty.
LAUNCHPAD_ADMIN_PASSWORD=

# Currency of the contract rates and every cost the dashboard shows (ISO 4217). Default USD.
LAUNCHPAD_CURRENCY=USD

# The public origin customer sites load the widget and tokens from.
PUBLIC_BASE_URL=http://localhost:3000

# Internal URL of the style sniffer, and the shared secret the console sends it.
SNIFFER_URL=http://localhost:4100
SNIFFER_TOKEN=

# --- M0 spike only (spike/m0.ts) --------------------------------------------
SPIKE_SITE_URL=
SPIKE_MAX_PAGES=100

# Copy to .env (never commit it). Used by the console, the worker and the M0 spike.

# --- Agentic RAG credentials -------------------------------------------------
# NUA key with KB management enabled (Manage account » NUA keys). Required: it creates KBs,
# service accounts and keys for every deployment. Zone and account are read from it.
PAR_NUA_KEY=

# Personal Access Token. Optional: adds account limits and processing/storage usage to the
# cost dashboard (the Account API rejects NUA keys). Sent as "Authorization: Bearer".
PAR_PAT=

# Optional overrides; normally resolved from the NUA key.
PAR_ACCOUNT=
PAR_ZONE=

# --- Console ----------------------------------------------------------------
DATABASE_URL=postgres://launchpad:launchpad@localhost:5432/launchpad

# 32 random bytes, base64. Encrypts every stored KB key. Generate with: openssl rand -base64 32
# Losing it means re-issuing every deployment's keys.
LAUNCHPAD_MASTER_KEY=

# --- Sign-in ------------------------------------------------------------------
# Each person signs in with their own work account (OIDC: Microsoft Entra ID, Google, or any
# provider with discovery). Register the console as a web app with the redirect URI
# <PUBLIC_BASE_URL>/auth/callback. Entra: https://login.microsoftonline.com/<tenant id>/v2.0
# Google: https://accounts.google.com
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Become admins on their first sign-in, so a new console has someone to invite the rest.
LAUNCHPAD_ADMIN_EMAILS=

# Setup mode, used only while OIDC isn't configured: one shared password (HTTP Basic, any
# user name), and nobody named in the audit log. The console refuses requests without it.
LAUNCHPAD_ADMIN_PASSWORD=

# --- Alerts and leads by email (optional; webhooks work without it) -------------
# smtp(s)://user:password@host:port
SMTP_URL=
SMTP_FROM="Launchpad <launchpad@agency.example>"

# Currency of the contract rates and every cost the dashboard shows (ISO 4217). Default USD.
LAUNCHPAD_CURRENCY=USD

# The public origin customer sites load the widget and tokens from.
PUBLIC_BASE_URL=http://localhost:3000

# Internal URL of the sniffer (site scans, content sync, installation checks), and the shared
# secret the console and the worker send it.
SNIFFER_URL=http://localhost:4100
SNIFFER_TOKEN=
# Development only: let the sniffer load test pages on this machine (localhost).
# SNIFFER_ALLOW_LOOPBACK=1

# --- M0 spike only (spike/m0.ts) --------------------------------------------
SPIKE_SITE_URL=
SPIKE_MAX_PAGES=100
